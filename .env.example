# ─────────────────────────────────────────────────────────────
# FK Éditions — variables d'environnement (exemple)
# Copiez ce fichier en `.env` et remplissez chaque valeur.
# NE COMMITEZ JAMAIS votre `.env` réel.
# ─────────────────────────────────────────────────────────────

# Base de données MySQL 8+
DATABASE_URL="mysql://user:password@localhost:3306/fkeditions"

# Authentification (NextAuth)
# Générez un secret : `openssl rand -base64 32`
NEXTAUTH_SECRET="votre-secret-genere"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="editionsfk@gmail.com"

# Paiements — Stripe (carte bancaire)
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Paiements — PayPal
PAYPAL_MODE="sandbox"                    # "sandbox" ou "live"
PAYPAL_CLIENT_ID="xxx"
PAYPAL_CLIENT_SECRET="xxx"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="xxx"

# Emails transactionnels (Resend)
RESEND_API_KEY="re_xxx"

# Stockage des fichiers — AWS S3
# (couvertures, PDF, ePub, audios, avatars)
AWS_REGION="eu-west-3"
AWS_ACCESS_KEY_ID="xxx"
AWS_SECRET_ACCESS_KEY="xxx"
S3_BUCKET="fkeditions-uploads"
